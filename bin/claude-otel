#!/usr/bin/env bash
# Run a Claude sandbox with the claude-otel kit, after checking the host viewer.
#
#   claude-otel [options] [sbx run args...]
#
# Anything not recognised as an option is passed to `sbx run claude --kit kit/`,
# so:  claude-otel --name my-sbx .   ==   sbx run claude --kit kit/ --name my-sbx .
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
KIT_DIR="$(cd -P "$(dirname "$src")/.." && pwd)/kit"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-otel"
PORT=4318
UI_PORT=8000
CAPTURE=""
DB=""
START_VIEWER=0
CHECK_ONLY=0
INSTALL_CMD='brew tap ctrlspice/otel-desktop-viewer && brew install --cask otel-desktop-viewer'

usage() {
  cat <<EOF
Usage: claude-otel [options] [sbx run args...]

  --port N             OTLP/HTTP port of the viewer (default $PORT)
  --ui-port N          viewer web UI port, used when starting one (default $UI_PORT)
  --capture MODE       none | tools | full (kit default: tools)
  --start-viewer       start otel-desktop-viewer if nothing is listening on --port
  --db FILE            with --start-viewer: persist telemetry to this DuckDB file
  --check              run the host checks only, do not call sbx
  -h, --help           show this help

Options must come before sbx arguments. Use -- to end option parsing.
EOF
}

die() { echo "claude-otel: $*" >&2; exit 1; }
warn() { echo "claude-otel: warning: $*" >&2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --port)         PORT="${2:?--port needs a value}"; shift 2 ;;
    --ui-port)      UI_PORT="${2:?--ui-port needs a value}"; shift 2 ;;
    --capture)      CAPTURE="${2:?--capture needs a value}"; shift 2 ;;
    --start-viewer) START_VIEWER=1; shift ;;
    --db)           DB="${2:?--db needs a value}"; shift 2 ;;
    --check)        CHECK_ONLY=1; shift ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; break ;;
    *)              break ;;
  esac
done

case "$PORT" in ''|*[!0-9]*) die "--port must be a number" ;; esac
case "$CAPTURE" in ''|none|tools|full) ;; *) die "--capture must be none, tools or full" ;; esac

[ -f "$KIT_DIR/kit.yaml" ] || die "kit not found at $KIT_DIR (is bin/claude-otel still inside its repo?)"
command -v sbx >/dev/null 2>&1 || [ "$CHECK_ONLY" = 1 ] || die "sbx not found on PATH"

if ! command -v otel-desktop-viewer >/dev/null 2>&1; then
  {
    echo "claude-otel: otel-desktop-viewer is not installed, so telemetry would have nowhere to go."
    echo "Install it with:"
    echo "  $INSTALL_CMD"
    echo "See https://github.com/CtrlSpice/otel-desktop-viewer for other install methods."
  } >&2
  exit 1
fi

if ! otel-desktop-viewer --help 2>&1 | grep -qE '^[[:space:]]+query[[:space:]]'; then
  warn "this otel-desktop-viewer build has no 'query' command; the web UI works but the agent skill will not"
fi

viewer_up() {
  curl -sf -m 2 -o /dev/null -X POST -H 'content-type: application/x-protobuf' \
    --data-binary '' "http://localhost:$PORT/v1/traces"
}

if viewer_up; then
  echo "claude-otel: viewer listening on localhost:$PORT" >&2
elif [ "$START_VIEWER" = 1 ]; then
  mkdir -p "$STATE_DIR"
  args=(--open-browser=false --http "$PORT" --grpc "$((PORT - 1))" --browser-port "$UI_PORT")
  [ -n "$DB" ] && args+=(--db "$DB")
  nohup otel-desktop-viewer "${args[@]}" >"$STATE_DIR/viewer-$PORT.log" 2>&1 &
  echo $! >"$STATE_DIR/viewer-$PORT.pid"
  for _ in $(seq 1 30); do viewer_up && break; sleep 0.5; done
  viewer_up || die "started a viewer but it is not answering on localhost:$PORT; see $STATE_DIR/viewer-$PORT.log"
  echo "claude-otel: started viewer (pid $(cat "$STATE_DIR/viewer-$PORT.pid")), UI at http://localhost:$UI_PORT" >&2
  echo "claude-otel: it keeps running after the sandbox exits; stop it with: kill \$(cat $STATE_DIR/viewer-$PORT.pid)" >&2
else
  warn "nothing is listening on localhost:$PORT. Telemetry will be dropped until a viewer is running."
  warn "start one with: otel-desktop-viewer   (or rerun with --start-viewer)"
fi

[ "$CHECK_ONLY" = 1 ] && exit 0

kit_args=(--kit "$KIT_DIR" --kit-arg "viewerPort=$PORT")
[ -n "$CAPTURE" ] && kit_args+=(--kit-arg "capture=$CAPTURE")

exec sbx run claude "${kit_args[@]}" "$@"
